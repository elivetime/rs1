# Supabase (server-side only; never expose the service role key to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Management login for /admin
ADMIN_PASSWORD=
# Random 32+ character string used to sign the admin session cookie
ADMIN_SESSION_SECRET=

# Public site URL (used in emails and calendar invites)
SITE_URL=https://aiuniverse.rsvp

# Optional email via Resend. Without these, requests still save; you just won't get emails.
RESEND_API_KEY=
FROM_EMAIL=AIUniverse.one <meetings@aiuniverse.rsvp>
NOTIFY_EMAIL=

# Booking window (Eastern Time)
BOOKING_TIMEZONE=America/New_York
BOOKING_DAY_START=10
BOOKING_DAY_END=17
BOOKING_SLOT_MINUTES=30
BOOKING_DAYS_AHEAD=21

# Founder video on /pitch. A direct .mp4/.webm plays inline; any other URL is embedded,
# with a "watch on LiveVideo" fallback link underneath.
PITCH_VIDEO_URL=https://myspace.livevideo.com
