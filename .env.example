# Every variable the application reads (grep for process.env), grouped by where it
# is read. Copy to .env.local for development; on Railway set them as service
# variables. Nothing is read with a NEXT_PUBLIC_ prefix: no value reaches the browser.

# --- Supabase (lib/db.ts) ---------------------------------------------------------
# Required. On Vercel these two are NOT typed in by hand: they are injected by the
# Vercel Marketplace Supabase integration store (store_nBwBlm3m8BETTmDi) attached to
# project rs1-mdc2. That store also injects 14 other keys the code never reads
# (NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY,
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SECRET_KEY, SUPABASE_JWT_SECRET, POSTGRES_URL, POSTGRES_URL_NON_POOLING,
# POSTGRES_PRISMA_URL, POSTGRES_HOST, POSTGRES_USER, POSTGRES_PASSWORD,
# POSTGRES_DATABASE). Do not carry those over. After the database move
# (docs/RAILWAY.md) both values come from the new project in the owned Supabase org.
# Server-side only; never expose the service role key to the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin sign-in for /admin (lib/auth.ts) ----------------------------------------
# Required. Plain secrets on Vercel today; copy the same values to Railway so the
# existing password keeps working.
ADMIN_PASSWORD=
# Random 32+ character string used to sign the admin session cookie
ADMIN_SESSION_SECRET=

# --- Site (lib/config.ts) ----------------------------------------------------------
# Public site URL used in emails and calendar invites. Default: https://aiuniverse.rsvp
SITE_URL=https://aiuniverse.rsvp

# --- Email via Resend (lib/email.ts, app/api/requests/route.ts) ---------------------
# Optional. Not set on Vercel today, so no email is sent in production. Without
# RESEND_API_KEY + FROM_EMAIL, requests still save and sendEmail() returns false.
RESEND_API_KEY=
FROM_EMAIL=AIUniverse.one <meetings@aiuniverse.rsvp>
# Management address that gets a "New call request" email for each booking.
NOTIFY_EMAIL=

# --- Booking window (lib/config.ts) -------------------------------------------------
# Optional. Values below are both the in-code defaults and what Vercel has set.
BOOKING_TIMEZONE=America/New_York
BOOKING_DAY_START=10
BOOKING_DAY_END=17
BOOKING_SLOT_MINUTES=30
BOOKING_DAYS_AHEAD=21

# --- Founder video on /pitch (lib/config.ts) ----------------------------------------
# Optional. A direct .mp4/.webm plays inline; any other URL is embedded, with a
# "watch on LiveVideo" fallback link underneath. /pitch is a static route, so this
# value is read at BUILD time (see the ARG in the Dockerfile).
PITCH_VIDEO_URL=https://myspace.livevideo.com

# --- Runtime (Next standalone server.js, not application code) ----------------------
# Railway injects PORT. HOSTNAME=0.0.0.0 is set in the Dockerfile. Do not set either
# by hand on Railway.
# PORT=3000
# HOSTNAME=0.0.0.0
